# ─────────────────────────────────────────────────────────────── Public (shipped to the browser)

# 84532 = Base Sepolia, 31337 = local anvil devnet
NEXT_PUBLIC_CHAIN_ID=84532
# Optional: a dedicated RPC (Alchemy, QuickNode, …). Defaults to https://sepolia.base.org
NEXT_PUBLIC_RPC_URL=
# Printed by `pnpm --filter @pactum/contracts deploy`
NEXT_PUBLIC_PACTUM_ADDRESS=
NEXT_PUBLIC_USD_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
# Optional: a human appeal court (EOA or multisig). Enables appeals for "Standard" agreements.
NEXT_PUBLIC_APPEAL_COURT=
# Your deployed URL, used for canonical links and social previews
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─────────────────────────────────────────────────────────────── Server only (never exposed)

# Claude. Set ONE of these. Without either, the app runs a deterministic simulator and says so in the UI.
# Direct from Anthropic (https://console.anthropic.com):
ANTHROPIC_API_KEY=
# Or through OpenRouter (https://openrouter.ai/keys). Model ids are mapped for you (claude-opus-5-5 → anthropic/claude-opus-5.5).
OPENROUTER_API_KEY=
# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_TRIBUNAL_EFFORT=medium
# AI_JUROR_MODELS=claude-opus-5-5,claude-opus-5-5,claude-opus-5-5
# AI_SIMULATE=1

# Signs tribunal rulings (EIP-712). Its address becomes the default arbiter of new agreements.
ARBITER_PRIVATE_KEY=
# Ada's wallet. Also funds the testnet faucet (keep ~0.05 Base Sepolia ETH in it).
AGENT_PRIVATE_KEY=

# IPFS pinning (https://app.pinata.cloud → API Keys → JWT). Required in production.
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# Durable KV for rate limits, tribunal locks and one-ruling-per-dispute (Upstash Redis).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: server-side RPC (defaults to NEXT_PUBLIC_RPC_URL)
RPC_URL=
