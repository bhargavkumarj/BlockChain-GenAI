{
  "name": "pactum",
  "private": true,
  "description": "Pactum: AI-drafted agreements, on-chain escrow, and an AI tribunal for disputes.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "contracts:build": "pnpm --filter @pactum/contracts build",
    "contracts:test": "pnpm --filter @pactum/contracts test",
    "dev": "pnpm --filter @pactum/web dev",
    "build": "pnpm --filter @pactum/web build",
    "lint": "pnpm --filter @pactum/web lint",
    "typecheck": "pnpm --filter @pactum/web typecheck",
    "test": "pnpm -r test"
  }
}
